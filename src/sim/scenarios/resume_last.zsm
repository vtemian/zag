# Resume pair: resume step.
#
# Requires `resume_seed.zsm` to have run first from the same cwd so the
# most recent `.zag/sessions/*.jsonl` carries the seed token. Spawns
# zag with --last and asserts the seed user message rendered. The
# token is the bytes you typed, not what the model said, so this
# anchors on deterministic data even though LLM replies vary.

spawn ./zig-out/bin/zag --last
wait_text /zag-resume-seed-token-FT4/ 10s
snapshot resumed
send "/quit" <Enter>
wait_exit
