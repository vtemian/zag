# read + edit tool loop. We pre-stage a file via bash, ask zag to edit
# one line, then re-read. Assertions anchor on bash stdout only: the
# staged lines are written via `rev` of reversed seeds (so the prompt
# never contains the asserted text), and the post-edit check reads the
# file through `tr a-z A-Z` (the edit prompt must name the literal
# old/new strings, so the lowercase forms are tainted by the echo).

spawn ./zig-out/bin/zag
wait_text /Welcome to zag/
wait_idle 500ms
send "Run one bash command: rm -rf /tmp/zag-sim-read-edit && mkdir -p /tmp/zag-sim-read-edit && (echo 3Q7-erofeb=ahpla | rev; echo em-peek=ateb | rev) > /tmp/zag-sim-read-edit/note.txt && cat /tmp/zag-sim-read-edit/note.txt" <Enter>
wait_text /alpha=before-7Q3/ 45s
wait_text /beta=keep-me/ 5s
send "Use the edit tool on /tmp/zag-sim-read-edit/note.txt to replace 'alpha=before-7Q3' with 'alpha=after-9F2'. Leave the second line alone. Then run bash: cat /tmp/zag-sim-read-edit/note.txt | tr a-z A-Z" <Enter>
wait_text /ALPHA=AFTER-9F2/ 60s
wait_text /BETA=KEEP-ME/ 5s
snapshot final
send "/quit" <Enter>
wait_exit
