# read + edit tool loop. We pre-stage a file via bash, ask zag to edit
# one line, then re-read. Asserts anchor on bash stdout (deterministic)
# rather than model prose. wait_text deadlines accommodate slow models
# without burning the whole budget when the token shows up fast.

spawn ./zig-out/bin/zag
wait_text /Welcome to zag/
wait_idle 500ms
send "Run a single bash command: rm -rf /tmp/zag-sim-read-edit && mkdir -p /tmp/zag-sim-read-edit && (echo alpha=before-7Q3; echo beta=keep-me) > /tmp/zag-sim-read-edit/note.txt && cat /tmp/zag-sim-read-edit/note.txt" <Enter>
wait_text /alpha=before-7Q3/ 45s
wait_text /beta=keep-me/ 5s
send "Use the edit tool on /tmp/zag-sim-read-edit/note.txt to replace 'alpha=before-7Q3' with 'alpha=after-9F2'. Leave the beta line alone. Then bash 'cat /tmp/zag-sim-read-edit/note.txt' so the new contents print." <Enter>
wait_text /alpha=after-9F2/ 60s
wait_text /beta=keep-me/ 5s
snapshot final
send "/quit" <Enter>
wait_exit
