# Single bash tool call. The prompt carries only the REVERSED token and
# asks bash to `rev` it, so the asserted text can only come from the
# tool's stdout — never from the prompt's own echo on the grid (which
# made the old wait_text match in ~10ms and /quit mid-turn).

spawn ./zig-out/bin/zag
wait_text /Welcome to zag/
wait_idle 500ms
send "Use the bash tool to run exactly: echo 3Q7-nekot-hsab-gaz | rev" <Enter>
wait_text /zag-bash-token-7Q3/ 60s
snapshot final
send "/quit" <Enter>
wait_exit
