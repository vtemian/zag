# Single bash tool call. Asks the model to shell out for a deterministic
# string and asserts the string lands on the grid. The model's wording
# around the tool call is non-deterministic, but `echo`'s output isn't,
# so we anchor on the bash stdout that the tool result must surface.

spawn ./zig-out/bin/zag
wait_text /Welcome to zag/
wait_idle 500ms
send "Use the bash tool to run exactly this command: echo zag-bash-token-7Q3. Do not print the token any other way." <Enter>
wait_idle 30s
expect_text /zag-bash-token-7Q3/
snapshot final
send "/quit" <Enter>
wait_exit
